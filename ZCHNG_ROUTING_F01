    lv_update_required = abap_true.

     WRITE: / 'Standard Value 2: DIFFERENT',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.

ELSE.

  WRITE: / 'Standard Value 2: SAME',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.


  ENDIF.


  "--------------------------------------------------
  " Standard Value 3
  "--------------------------------------------------

  lv_sap_value =
    CONV decfloat34(
      ls_routing-STANDARDWORKQUANTITY3 ).

  lv_target_value =
    CONV decfloat34(
      ps_excel-standard_value3 ).

  IF lv_sap_value <> lv_target_value.

    lv_update_required = abap_true.

    WRITE: / 'Standard Value 3: DIFFERENT',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.

ELSE.

  WRITE: / 'Standard Value 3: SAME',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.

  ENDIF.


  "--------------------------------------------------
  " Standard Value 4
  "--------------------------------------------------

  lv_sap_value =
    CONV decfloat34(
      ls_routing-STANDARDWORKQUANTITY4 ).

  lv_target_value =
    CONV decfloat34(
      ps_excel-standard_value4 ).

  IF lv_sap_value <> lv_target_value.

    lv_update_required = abap_true.

     WRITE: / 'Standard Value 4: DIFFERENT',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.

ELSE.

  WRITE: / 'Standard Value 4: SAME',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.

  ENDIF.


  "--------------------------------------------------
  " Standard Value 5
  "--------------------------------------------------

  lv_sap_value =
    CONV decfloat34(
      ls_routing-STANDARDWORKQUANTITY5 ).

  lv_target_value =
    CONV decfloat34(
      ps_excel-standard_value5 ).


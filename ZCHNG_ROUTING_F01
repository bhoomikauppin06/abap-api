FORM compare_values  USING    ps_excel TYPE ty_excel_data.


 CLEAR lv_update_required.


  "--------------------------------------------------
  " Unit 1
  "--------------------------------------------------

  IF ls_routing-standardworkquantityunit1 <>
     ps_excel-unit1.

    lv_update_required = abap_true.

  ENDIF.


  "--------------------------------------------------
  " Activity Type 1
  "--------------------------------------------------

  IF ls_routing-COSTCTRACTIVITYTYPE1 <>
     ps_excel-activity_type1.

    lv_update_required = abap_true.

  ENDIF.


  "--------------------------------------------------
  " Unit 2
  "--------------------------------------------------

  IF ls_routing-STANDARDWORKQUANTITYUNIT2 <>
     ps_excel-unit2.

    lv_update_required = abap_true.

  ENDIF.


  "--------------------------------------------------
  " Activity Type 2
  "--------------------------------------------------

  IF ls_routing-COSTCTRACTIVITYTYPE2 <>
     ps_excel-activity_type2.

    lv_update_required = abap_true.

  ENDIF.


  "--------------------------------------------------

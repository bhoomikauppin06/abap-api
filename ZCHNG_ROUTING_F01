  "--------------------------------------------------

  IF ls_routing-STANDARDWORKQUANTITYUNIT5 <>
     ps_excel-unit5.

    lv_update_required = abap_true.

  ENDIF.


  "--------------------------------------------------
  " Activity Type 5
  "--------------------------------------------------

  IF ls_routing-COSTCTRACTIVITYTYPE5 <>
     ps_excel-activity_type5.

    lv_update_required = abap_true.

  ENDIF.


  "--------------------------------------------------
  " Base Quantity
  "--------------------------------------------------

  lv_sap_value =
    CONV decfloat34(
      ls_routing-OPERATIONREFERENCEQUANTITY ).

  lv_target_value =
    CONV decfloat34(
      ps_excel-base_quantity ).

  IF lv_sap_value <> lv_target_value.

    lv_update_required = abap_true.
     WRITE: / 'Base Quantity: DIFFERENT',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.

   ELSE.

  WRITE: / 'Base Quantity: SAME',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.

  ENDIF.


  "--------------------------------------------------
  " Standard Value 1
  "--------------------------------------------------

  lv_sap_value =
    CONV decfloat34(
      ls_routing-STANDARDWORKQUANTITY1 ).

  lv_target_value =
    CONV decfloat34(
      ps_excel-standard_value1 ).

  IF lv_sap_value <> lv_target_value.

    lv_update_required = abap_true.

    WRITE: / 'Standard Value 1: DIFFERENT',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.

ELSE.

  WRITE: / 'Standard Value 1: SAME',
         / '  SAP  :', lv_sap_value,
         / '  Excel:', lv_target_value.

  ENDIF.


  "--------------------------------------------------

*PERFORM SEND_BATCH.
*&---------------------------------------------------------------------*
*& Form SEND_BATCH
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM SEND_BATCH .


  DATA:
    lv_batch_body TYPE string,
    lv_batch_id   TYPE string,
    lv_change_id  TYPE string,
    lv_counter    TYPE i.

  DATA: lv_send_start TYPE i,
      lv_send_end   TYPE i,
      lv_recv_start TYPE i,
      lv_recv_end   TYPE i,
      lv_diff       TYPE i.


lv_batch_id = 'batch'.

lv_batch_body = ``.

lv_counter = 0.

LOOP AT gt_batch_request INTO gs_batch_request.

  lv_counter = lv_counter + 1.

  lv_change_id = |changeset{ lv_counter }|.

  lv_batch_body =
    lv_batch_body &&
    |--{ lv_batch_id }\r\n| &&
    |Content-Type: multipart/mixed; boundary={ lv_change_id }\r\n| &&
    |\r\n| &&

    |--{ lv_change_id }\r\n| &&
    |Content-Type: application/http\r\n| &&
    |Content-Transfer-Encoding: binary\r\n| &&
    |Content-ID: { lv_counter }\r\n| &&
    |\r\n| &&

    |PATCH { gs_batch_request-uri } HTTP/1.1\r\n| &&
    |Content-Type: application/json\r\n| &&
    |If-Match: *\r\n| &&
    |\r\n| &&

    |{ gs_batch_request-payload }\r\n| &&

    |--{ lv_change_id }--\r\n|.

ENDLOOP.

lv_batch_body =
  lv_batch_body &&
  |--{ lv_batch_id }--|.


  "------------------------------------------------------------
  " Create HTTP client
  "------------------------------------------------------------

*  cl_http_client=>create_by_destination(
*    EXPORTING
*      destination = 'Z_ROUTING_API'
*    IMPORTING
*      client      = lo_batch_client ).
*
*  lo_batch_client->propertytype_logon_popup =
*    lo_batch_client->co_disabled.

  LO_CLIENT->request->set_method(
    if_http_request=>co_request_method_post ).

  LO_CLIENT->request->set_header_field(
    name  = 'Content-Type'
    value = 'multipart/mixed; boundary=batch' ).

  LO_CLIENT->request->set_header_field(
    name  = 'X-CSRF-Token'
    value = lv_csrf_token ).

  LO_CLIENT->request->set_header_field(
    name  = 'Accept'
    value = 'application/json' ).

  LO_CLIENT->request->set_header_field(
    name  = '~request_uri'
    value = '/sap/opu/odata/sap/API_PRODUCTION_ROUTING;v=3/$batch' ).

  LO_CLIENT->request->set_cdata(
    lv_batch_body ).


  "------------------------------------------------------------
  " Send batch
  "------------------------------------------------------------
GET RUN TIME FIELD lv_send_start.

  LO_CLIENT->send( ).

GET RUN TIME FIELD lv_send_end.

lv_diff = lv_send_end - lv_send_start.

WRITE: / 'SEND time:', lv_diff, 'microseconds'.



GET RUN TIME FIELD lv_recv_start.

  LO_CLIENT->receive( ).

GET RUN TIME FIELD lv_recv_end.

lv_diff = lv_recv_end - lv_recv_start.

WRITE: / 'RECEIVE time:', lv_diff, 'microseconds'.


*  lv_status_code =
    LO_CLIENT->response->get_status(
      IMPORTING
        CODE  =  LV_STATUS_CODE
        reason = lv_status_reason ).

  lv_response =
    LO_CLIENT->response->get_cdata( ).

  WRITE: / 'Batch status:', lv_status_code,
         / 'Batch reason:', lv_status_reason.

  IF lv_status_code = 202 OR lv_status_code = 200.

    WRITE: / 'Batch processed successfully.',
           / 'PATCH requests:', lv_counter.

  ELSE.

    WRITE: / 'Batch failed.'.
    WRITE: / lv_response.

  ENDIF.

*  LO_CLIENT->close( ).

  CLEAR gt_batch_request.



ENDFORM.
